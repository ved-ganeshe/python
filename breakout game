import turtle
import time
screen = turtle.Screen()
screen.setup(width=600, height = 400)
screen.tracer(0)
screen.bgcolor('black')

paddle = turtle.Turtle()
paddle.shape('square')
paddle.color("white")
paddle.penup()
paddle.speed(0)
paddle.goto(0, 180)
paddle_width = 120
ball = turtle.Turtle()
ball.shape('circle')
ball.color('red')
ball.penup()
ball.speed(0)
ball.goto(0, 0)
ball.dx = 2 ball.dy = -2
bricks = []
colors = ['red', 'orange', 'yellow', 'lime', 'green', 'skyblue', 'blue']
for row in range (7):
    for col in range(-250, 300, 80):
        brick = turtle.Turtle()
        brick.shape("square")
        brick.color(colors[row]) # different colors for each row
        brick.pu()
        brick.speed(0)
        brick.goto(col, 150 - (row * 30))
        bricks.append(brick)
score = 0
score_display = turtle.Turtle()
score_display.write('Score:{}'.format(score), align='center',font=("Ubuntu",16, 'normal'))

turtle.done